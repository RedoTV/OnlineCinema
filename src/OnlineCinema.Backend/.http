### ============================================
### MOVIES - Загрузка видео (Распределение по ID)
### ============================================

# Фильм 1: Джон Уик -> John_Wick.mp4
POST {{baseUrl}}/api/Movies/1/upload-video
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW
Authorization: Bearer {{token}}

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="John_Wick.mp4"
Content-Type: video/mp4

< ./samples/films/John_Wick.mp4
------WebKitFormBoundary7MA4YWxkTrZu0gW--

