# Копируй в .env и меняй значения под себя. В репозиторий .env не коммитим.

POSTGRES_DB=onlinecinema_db
POSTGRES_USER=cinema_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=onlinecinema_db;Username=cinema_user;Password=change_me

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:80
FRONTEND_URL=http://localhost:3000

# Ставь true при первом запуске, чтобы наполнить каталог демо-контентом
# (жанры/актёры/фильмы/сериалы). После этого можно выключить.
SEED_DEMO_DATA=true
# Импортировать samples/posters и локально смонтированные samples/films в MinIO.
# Импорт идемпотентный: пользовательские загрузки не перезаписываются.
IMPORT_SAMPLE_MEDIA=true
SampleMedia__Path=/app/samples

# MinIO / S3-совместимое хранилище
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
Minio__Endpoint=minio:9000
Minio__AccessKey=minioadmin
Minio__SecretKey=minioadmin123
Minio__Bucket=cinema

# RabbitMQ event bus. Если брокера нет — бэкенд работает без событий
RabbitMq__Uri=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Сгенерируй свежий секрет: openssl rand -base64 48
JwtSettings__Secret=change_me
JwtSettings__Issuer=OnlineCinema
JwtSettings__Audience=OnlineCinemaUsers
JwtSettings__ExpirationMinutes=60

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
Logging__LogLevel__Microsoft.EntityFrameworkCore=Information
