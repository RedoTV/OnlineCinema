# Копируй в .env и меняй значения под себя. В репозиторий .env не коммитим.

POSTGRES_DB=onlinecinema_db
POSTGRES_USER=cinema_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=onlinecinema_db;Username=cinema_user;Password=change_me

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:80
FRONTEND_URL=http://localhost:3000

# Сгенерируй свежий секрет: openssl rand -base64 48
JwtSettings__Secret=change_me
JwtSettings__Issuer=OnlineCinema
JwtSettings__Audience=OnlineCinemaUsers
JwtSettings__ExpirationMinutes=60

StaticFiles__FilmsPath=static/films
StaticFiles__PostersPath=static/posters
StaticFiles__ActorsPath=static/actors

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
Logging__LogLevel__Microsoft.EntityFrameworkCore=Information
